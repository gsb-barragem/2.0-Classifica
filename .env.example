# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# 1. CLASSIFICA CSB (Banco próprio: Pareceres, Ofícios, Usuários, Auditoria)
# ==============================================================================
# Estes valores são públicos no navegador. NUNCA use a chave service_role aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ==============================================================================
# 2. ADMINISTRA BARRAGENS — LEITURA CANÔNICA SERVER-SIDE (/api/administra-leitura)
# ==============================================================================
# Variáveis EXCLUSIVAS DE SERVIDOR (NUNCA use prefixo VITE_ para chaves secretas).
# Verificação da sessão do Classifica no servidor:
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Conexão server-side com o Administra Barragens:
ADMINISTRA_SUPABASE_URL=
ADMINISTRA_SUPABASE_SERVICE_ROLE_KEY=

# Variáveis públicas legadas de integração entre sistemas (apenas chave anon, se aplicável):
VITE_ADMINISTRA_SUPABASE_URL=
VITE_ADMINISTRA_SUPABASE_ANON_KEY=

# ==============================================================================
# 3. NOTIFICA CSB & FISCALIZA BARRAGENS (Consultas cruzadas somente leitura)
# ==============================================================================
# Opcional: preencha caso o Classifica consulte diretamente visões somente-leitura
# desses sistemas além do índice unificado do Administra Barragens.
VITE_NOTIFICA_SUPABASE_URL=
VITE_NOTIFICA_SUPABASE_ANON_KEY=

VITE_FISCALIZA_SUPABASE_URL=
VITE_FISCALIZA_SUPABASE_ANON_KEY=
